<h1 class="title">Card Bards</h1>
<div id="item">
<div id="header">
<h1><%= @item.name %></h1>
<% if @item.avatar.attached? %>
      <%= image_tag url_for(@item.avatar), size: "300x400", alt: "item Avatar"%>
    <% else %>
      <p>No Image Attached</p>
    <% end %>
</div>
<div id="details">
<h2><%= @item.franchise %></h2>
<h2><%= @item.price %></h2>
<p><%= @item.description %></p>
<h3><%= @item.stock %></h3>
</div>
<%= button_to "Add to Cart",
              add_to_cart_path(item_id: @item.id),
              method: :post %>
</div>
<p><a href="/item"></a></p>
<h4 id="back"><a href = "/items/">Back</a></h4>
