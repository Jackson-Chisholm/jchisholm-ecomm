<h1><%= @item.name %></h1>
<% if @item.avatar.attached? %>
      <%= image_tag url_for(@item.avatar), alt: "item Avatar"%>
    <% else %>
      <p>No Image Attached</p>
    <% end %>
<h2><%= @item.franchise %></h2>
<h2><%= @item.price %></h2>
<p><%= @item.description %></p>
<h3><%= @item.stock %></h3>
<%= button_to "Add to Cart",
              add_to_cart_path(item_id: @item.id),
              method: :post %>
<p><a href="/item"></a></p>
<h4><a href = "/items/">Back</a></h4>
