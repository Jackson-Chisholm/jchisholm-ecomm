<h1>Card Bards</h1>

<% if customer_signed_in? %>
  Welcome, <%= current_customer.name %>

  <%= link_to "My Account", edit_customer_registration_path %>

  <%= button_to "Logout",
    destroy_customer_session_path,
    method: :delete,
    form: { data: { turbo: true } } %>

  <p><a href = "/customers/index">Order History</a></p>

<% else %>

  <%= link_to "Login", new_customer_session_path %>

  <%= link_to "Register", new_customer_registration_path %>

<% end %>

<h1>Current Items</h1>

<div id="franchise filter">
<%= form_with url: items_path, method: :get do |form| %>
  <% @franchises.each do |franchise| %>
      <%= form.radio_button :franchise, franchise %>
      <%= form.label :franchise, franchise, value: franchise %><br>
    <% end %>
  <%= form.submit "Filter" %>
<% end %>

<%= form_with url: items_path, method: :get do |form| %>
  <%= form.label :query, "Search:" %>
  <%= form.search_field :query %>
  <%= form.checkbox :limit_to_franchise %>
  <%= form.label :limit_to_franchise, "Search with a category?" %>
  <%= form.label :set %>
  <%= form.select :set,
                  @franchises,
                  { prompt: "Select a franchise" } %>
  <%= form.submit "Search" %>
<% end %>
</div>

<h2><a href = "/cart">Cart</a></h2>

<div style="font-size: 2rem;">
  <%= paginate @items %>
</div>

<div id="products">
  <% @items.each do |item| %>
    <div>
    <% if item.avatar.attached? %>
      <%= image_tag url_for(item.avatar), alt: "item Avatar"%>
    <% else %>
      <p>No Image Attached</p>
    <% end %>
      <a href="/items/<%= item.id %>">
        <p>*<%= item.name %></p>
        </a>
        <p>-Price: <%= item.price %></p>
    </div>
  <% end %>
</div>
